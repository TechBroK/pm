# OpenRouter API Configuration
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Application Environment (development, staging, production)
# Use "production" for deployment, "development" for local dev
ENVIRONMENT=development

# CORS Configuration
# For development: localhost:3000,localhost:8000,127.0.0.1:3000
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=localhost:3000,localhost:8000,127.0.0.1:3000

# Database (SQLite by default)
DATABASE_URL=sqlite:///kanban.db

# Seed initial data on startup 
# Set to false in production if database already has data
SEED_ON_STARTUP=true
